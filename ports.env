# Host ports bound to 127.0.0.1. Each cluster has its own block of ten with the same offsets:
# +0 gateway access, +1 Kubernetes API, +2 temporary request port used by commands,
# +3 agentgateway admin UI, +4 Grafana, +5 Prometheus, +6 to +9 reserved.
SHARED_GATEWAY_PORT=38480
SHARED_KUBERNETES_PORT=38481
SHARED_REQUEST_PORT=38482
SHARED_DASHBOARD_PORT=38483
SHARED_GRAFANA_PORT=38484
SHARED_PROMETHEUS_PORT=38485
# 38486 through 38489 are reserved for the shared cluster.
DEDICATED_GATEWAY_PORT=38490
DEDICATED_KUBERNETES_PORT=38491
DEDICATED_REQUEST_PORT=38492
DEDICATED_DASHBOARD_PORT=38493
DEDICATED_GRAFANA_PORT=38494
DEDICATED_PROMETHEUS_PORT=38495
# 38496 through 38499 are reserved for the dedicated cluster.
# 38470 through 38479 stay reserved for this project (the retired single-user cluster used them).
LEGACY_KUBERNETES_PORT=38471
