apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayBackend
metadata:
  name: foundry-model
  namespace: "@NAMESPACE@"
spec:
  ai:
    provider:
      azure:
        resourceType: Foundry
        resourceName: "@RESOURCE@"
        projectName: "@PROJECT@"
        model: "@DEPLOYMENT@"
        apiVersion: v1
  policies:
    auth:
      secretRef:
        name: foundry-provider
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: foundry-chat
  namespace: "@NAMESPACE@"
spec:
  parentRefs:
    - name: agentgateway-proxy
      sectionName: http
  rules:
    - matches:
        - method: POST
          path:
            type: Exact
            value: /v1/chat/completions
      backendRefs:
        - name: foundry-model
          group: agentgateway.dev
          kind: AgentgatewayBackend
