# Strict API key authentication before routing. With no tenant keys, every request gets 401.
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: tenant-auth
  namespace: "@NAMESPACE@"
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: agentgateway-proxy
  traffic:
    phase: PreRouting
    apiKeyAuthentication:
      mode: Strict
      configMapSelector:
        matchLabels:
          gateway.dev/component: tenant-key
