# Labels every proxy metric and access log line with the authenticated tenant.
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: tenant-telemetry
  namespace: "@NAMESPACE@"
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: agentgateway-proxy
  frontend:
    metrics:
      attributes:
        add:
          - name: tenant
            expression: 'apiKey.tenant'
    accessLog:
      attributes:
        add:
          - name: tenant
            expression: 'apiKey.tenant'
